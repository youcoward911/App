{
  "expo": {
    "name": "Scroll Pig",
    "slug": "PayPig",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF0F3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paypig.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Scroll Pig uses your approximate location to determine your city so it can rank you on a local leaderboard against other users in the same city. For example, if you are in Brooklyn, your stats will be compared against other pigs in Brooklyn. Your precise location is never stored or shared.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.paypig.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withScreenTime"
    ],
    "extra": {
      "eas": {
        "projectId": "fa4752e0-9878-4988-9def-e0111d9ab43f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
